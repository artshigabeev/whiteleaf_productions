# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Connection (from Cobra/DAS when API access is enabled) ---------------
DAS_HOST=
DAS_PORT=9910
DAS_USERNAME=
DAS_PASSWORD=
DAS_ACCOUNT=

# Comma-separated symbols to subscribe on startup
DAS_WATCHLIST=AAPL,MSFT

# Order route. Confirm the valid route names in your DAS spec — an invalid
# route is rejected by the broker, not by us.
DAS_DEFAULT_ROUTE=SMRTL

DAS_HEARTBEAT_INTERVAL=20
DAS_HEARTBEAT_TIMEOUT=60
DAS_MAX_RECONNECT_ATTEMPTS=0

# --- Safety ----------------------------------------------------------------
# true  = risk-check and log orders, send nothing (default)
# false = send real orders
DAS_DRY_RUN=true

DAS_LOG_DIR=logs
DAS_LOG_LEVEL=INFO

# --- Risk limits -----------------------------------------------------------
# Start far smaller than you think you need. These bind the worst case, and the
# worst case is a bug in your own strategy, not a bad market.
RISK_MAX_SHARES_PER_ORDER=100
RISK_MAX_POSITION_SHARES=200
RISK_MAX_NOTIONAL_PER_ORDER=5000
RISK_MAX_OPEN_ORDERS=5
RISK_MAX_DAILY_LOSS=500
RISK_MAX_ORDERS_PER_MINUTE=10

# Empty = allow any symbol. Strongly recommended to pin this while testing.
RISK_SYMBOL_ALLOWLIST=

RISK_ALLOW_SHORT=false
RISK_REQUIRE_MARKET_HOURS=true
